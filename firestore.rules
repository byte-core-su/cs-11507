rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep the existing 11501 teacher identity so both terms use one policy.
    function isTeacher() {
      return signedIn() && request.auth.token.email == 'jimwang@mail.qfm.kh.edu.tw';
    }

    // `terms.115-1` and `terms.115-2` are fields in the same private user
    // document. A learner may update their own learning data, but may never
    // alter teacher-owned progress fields.
    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isTeacher();
      allow create: if (signedIn() && request.auth.uid == userId
          && !request.resource.data.keys().hasAny(['computationalThinking', 'teacherProgress']))
        || isTeacher();
      allow update: if (signedIn() && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['computationalThinking', 'teacherProgress']))
        || (isTeacher()
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['teacherProgress', 'updatedAt']));
      allow delete: if false;
    }

    // Existing roster and verification-code flow, retained for both terms.
    match /rosters/{studentId} {
      allow get: if signedIn();
      allow list, create, delete: if isTeacher();
      allow update: if isTeacher()
        || (signedIn()
          && !resource.data.keys().hasAll(['verificationCode'])
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['verificationCode', 'verificationCodeUpdatedAt'])
          && request.resource.data.verificationCode is string
          && request.resource.data.verificationCode.matches('^[0-9]{6}$'));
    }

    // Teacher-only operational settings.  Classroom-to-task mapping is kept
    // outside student profiles so it never becomes visible in learner pages.
    match /teacherSettings/{settingId} {
      allow read, write: if isTeacher();
    }

    // A term ID is part of the document path, so 11501 and 11502 leaderboard
    // records remain separate while keeping the same validation policy.
    match /leaderboards/{termId}/difficulties/{difficulty}/scores/{scoreId} {
      allow read: if signedIn();
      // Historical random-ID scores are retained, but new results use one best per learner.
      allow write: if false;
    }

    function arenaStudent(studentId) {
      return signedIn() && studentId is string && studentId.matches('^15[0-9]{5}$')
        && request.auth.token.email == studentId + '@students.jimwang-4b0ca.firebaseapp.com';
    }
    function arenaDay() {
      return int((request.time.toMillis() + 28800000) / 86400000);
    }
    function arenaTerm(termId) {
      return termId in ['115-1', '115-2'];
    }
    match /arenaActivity/{accountId}/days/{dayId} {
      function validDaily() {
        let data = request.resource.data;
        let runPath = /databases/$(database)/documents/arenaActivity/$(accountId)/runs/$(data.lastRunId);
        let run = getAfter(runPath).data;
        return data.studentId == accountId && arenaStudent(accountId)
          && data.keys().hasOnly(['termId', 'day', 'studentId', 'count', 'lastRunId', 'updatedAt'])
          && arenaTerm(data.termId) && data.day is int && data.day == arenaDay()
          && dayId == data.termId + '_' + string(data.day)
          && data.count is int && data.count >= 1 && data.count <= 2
          && data.lastRunId is string && data.lastRunId.size() <= 80
          && data.updatedAt == request.time && !exists(runPath)
          && run.termId == data.termId && run.day == data.day
          && run.studentId == data.studentId && run.slot == data.count
          && run.status == 'active' && run.startedAt == request.time;
      }
      allow read: if isTeacher() || arenaStudent(accountId);
      allow create: if signedIn() && validDaily() && request.resource.data.count == 1;
      allow update: if signedIn() && validDaily()
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }
    match /arenaActivity/{accountId}/runs/{runId} {
      function validStart() {
        let data = request.resource.data;
        let dayId = data.termId + '_' + string(data.day);
        let daily = getAfter(/databases/$(database)/documents/arenaActivity/$(accountId)/days/$(dayId)).data;
        return data.studentId == accountId && arenaStudent(accountId)
          && data.keys().hasOnly(['termId', 'day', 'studentId', 'difficulty', 'slot', 'questionCount', 'status', 'startedAt'])
          && arenaTerm(data.termId) && data.day is int && data.day == arenaDay()
          && data.difficulty in ['easy', 'normal', 'hard']
          && data.questionCount == (data.termId == '115-1' ? 120 : 160)
          && data.slot is int && data.slot >= 1 && data.slot <= 2
          && data.status == 'active' && data.startedAt == request.time
          && daily.termId == data.termId && daily.studentId == data.studentId
          && daily.count == data.slot && daily.lastRunId == runId && daily.updatedAt == request.time;
      }
      function validFinish() {
        let data = request.resource.data;
        let lost = data.wrong + data.timeouts + data.departures;
        let maxLives = data.difficulty == 'easy' ? 3 : (data.difficulty == 'normal' ? 2 : 1);
        return data.studentId == accountId && arenaStudent(accountId)
          && resource.data.status == 'active' && data.status == 'finished'
          && data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'finishedAt', 'score', 'correct', 'wrong', 'timeouts', 'departures', 'rounds', 'won'
          ])
          && data.finishedAt == request.time && data.finishedAt >= data.startedAt
          && data.score is int && data.correct is int && data.correct >= 0 && data.correct <= data.questionCount
          && data.score >= data.correct * 1000 && data.score <= data.correct * 2000
          && data.wrong is int && data.wrong >= 0 && data.timeouts is int && data.timeouts >= 0
          && data.departures is int && data.departures >= 0 && lost <= maxLives
          && data.rounds is int && data.rounds == data.correct + lost
          && data.won is bool
          && (data.won ? (data.correct == data.questionCount && lost < maxLives) : lost == maxLives);
      }
      allow read: if isTeacher() || arenaStudent(accountId);
      allow create: if signedIn() && validStart();
      allow update: if signedIn() && validFinish();
      allow delete: if false;
    }
    match /leaderboards/{termId}/difficulties/{difficulty}/bests/{studentId} {
      function validBest() {
        let data = request.resource.data;
        let run = get(/databases/$(database)/documents/arenaActivity/$(studentId)/runs/$(data.runId)).data;
        return arenaStudent(studentId) && !studentId.matches('.*00$')
          && arenaTerm(termId) && difficulty in ['easy', 'normal', 'hard']
          && data.keys().hasOnly(['studentId', 'score', 'runId', 'timestamp'])
          && data.studentId == studentId && data.score is int && data.score > 0
          && data.runId is string && data.timestamp == request.time
          && run.status == 'finished' && run.termId == termId && run.difficulty == difficulty
          && run.studentId == studentId && run.score == data.score;
      }
      allow read: if signedIn();
      allow create: if signedIn() && validBest();
      allow update: if signedIn() && validBest() && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // Answer indexes live in a separate teacher-only collection.  They are
    // intentionally not readable by learners or included in the public site.
    match /quizAnswerKeys/{questionId} {
      allow read, write: if isTeacher();
    }

    // Each response is immutable.  The rule compares the student's selected
    // index against the protected answer key, so a learner cannot manufacture
    // a correct result simply by editing browser-side JavaScript.
    match /quizAttempts/{userId}/events/{attemptId} {
      function validChoiceAttempt() {
        let keyPath = /databases/$(database)/documents/quizAnswerKeys/$(request.resource.data.questionId);
        return request.resource.data.keys().hasOnly([
            'termId', 'questionId', 'source', 'selectedIndex',
            'questionText', 'optionCount', 'elapsedSeconds', 'correct', 'createdAt'
          ])
          && request.resource.data.termId is string
          && request.resource.data.termId.matches('^[0-9]{3}-[0-9]$')
          && request.resource.data.questionId is string
          && request.resource.data.questionId.matches('^q_[A-Za-z0-9_-]+$')
          && request.resource.data.source is string
          && request.resource.data.source.size() > 0
          && request.resource.data.source.size() <= 80
          && request.resource.data.questionText is string
          && request.resource.data.questionText.size() > 0
          && request.resource.data.questionText.size() <= 500
          && request.resource.data.optionCount is int
          && request.resource.data.optionCount >= 2
          && request.resource.data.optionCount <= 6
          && request.resource.data.selectedIndex is int
          && request.resource.data.selectedIndex >= 0
          && request.resource.data.selectedIndex < request.resource.data.optionCount
          && request.resource.data.elapsedSeconds is int
          && request.resource.data.elapsedSeconds >= 0
          && request.resource.data.elapsedSeconds <= 3600
          && request.resource.data.correct is bool
          && request.resource.data.createdAt == request.time
          && exists(keyPath)
          && request.resource.data.correct
             == (request.resource.data.selectedIndex == get(keyPath).data.answerIndex);
      }

      // Sorting activities use the same private key collection, but compare a
      // complete ordered block list rather than one selected option.
      function validSequenceAttempt() {
        let keyPath = /databases/$(database)/documents/quizAnswerKeys/$(request.resource.data.questionId);
        return request.resource.data.keys().hasOnly([
            'termId', 'questionId', 'source', 'questionText', 'optionCount',
            'responseValue', 'elapsedSeconds', 'correct', 'createdAt'
          ])
          && request.resource.data.termId is string
          && request.resource.data.termId.matches('^[0-9]{3}-[0-9]$')
          && request.resource.data.questionId is string
          && request.resource.data.questionId.matches('^q_[A-Za-z0-9_-]+$')
          && request.resource.data.source is string
          && request.resource.data.source.size() > 0
          && request.resource.data.source.size() <= 80
          && request.resource.data.questionText is string
          && request.resource.data.questionText.size() > 0
          && request.resource.data.questionText.size() <= 500
          && request.resource.data.optionCount is int
          && request.resource.data.optionCount >= 2
          && request.resource.data.optionCount <= 10
          && request.resource.data.responseValue is string
          && request.resource.data.responseValue.size() > 0
          && request.resource.data.responseValue.size() <= 1000
          && request.resource.data.elapsedSeconds is int
          && request.resource.data.elapsedSeconds >= 0
          && request.resource.data.elapsedSeconds <= 3600
          && request.resource.data.correct is bool
          && request.resource.data.createdAt == request.time
          && exists(keyPath)
          && get(keyPath).data.answerValue is string
          && request.resource.data.correct
             == (request.resource.data.responseValue == get(keyPath).data.answerValue);
      }

      allow create: if signedIn() && request.auth.uid == userId
        && (validChoiceAttempt() || validSequenceAttempt());
      allow get, list: if isTeacher() || (signedIn() && request.auth.uid == userId);
      allow update, delete: if false;
    }
  }
}
